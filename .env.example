# Copy to .env and export (or use `node --env-file=.env`). All optional for local no-Docker dev.

# Postgres. Unset = file store in .data/ (M1 behaviour). Start it: docker compose -f infra/docker-compose.yml up -d
# Owner/admin URL: used only to run migrations (creates the non-superuser role `lens_app`).
DATABASE_ADMIN_URL=postgres://lens:lens@localhost:5433/lens
# App URL: connects as lens_app so row-level security applies. Change the lens_app password in production.
DATABASE_URL=postgres://lens_app:lens_app@localhost:5433/lens

# Server-side GitHub token for unauthenticated (auth disabled) mode: private repos / higher rate limit.
GITHUB_TOKEN=

# GitHub OAuth app. Leaving GITHUB_CLIENT_ID unset DISABLES auth (single local tenant, open API).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Scopes requested at login. "read:user repo" is needed for private repos; use "read:user" for public only.
GITHUB_OAUTH_SCOPE=read:user repo

# Required when auth is enabled: >= 32 random chars (openssl rand -hex 32). Derives the token-encryption key.
SESSION_SECRET=

# Where the web app lives (OAuth redirect target, CSRF Origin allow-list, CORS).
APP_URL=http://localhost:5173
# Public URL of this API, used to build the OAuth callback (default http://localhost:$PORT).
API_URL=http://localhost:8787
PORT=8787
